{
  "name": "ai-inventory-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade Express.js backend for AI-powered vendor and inventory management platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "express",
    "zod",
    "pino",
    "inventory",
    "semiconductor",
    "procurement"
  ],
  "author": "AI Inventory Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.39",
    "@mistralai/mistralai": "^2.6.4",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.90",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
